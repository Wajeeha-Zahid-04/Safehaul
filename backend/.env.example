# Local development template: copy to .env and fill in. .env is git-ignored.
# Production (Render) sets these as environment variables instead; there DJANGO_DEBUG must be
# False (the default when unset), which also turns on the HTTPS settings below.
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# HTTPS redirect/HSTS/secure cookies. Defaults to on when DJANGO_DEBUG=False.
# DJANGO_SECURE_HTTPS=True
# Reverse proxies in front of the app (Render: 1). Used for per-IP throttling.
DJANGO_NUM_PROXIES=0
# OpenRouteService key (https://openrouteservice.org/dev/#/signup). Server-side only.
# If empty, the keyless Valhalla (routing) + Photon (geocode) fallback is used.
ORS_API_KEY=
# Optional, e.g. redis://localhost:6379/0. If empty, Django's in-process LocMem cache is used.
REDIS_URL=
